if($('#deviceFilter')){$('#deviceFilter').value=deviceFilter;$('#deviceFilter').onchange=e=>{deviceFilter=e.target.value;render()}}
if($('#resetDeviceFilters'))$('#resetDeviceFilters').onclick=()=>{deviceFilter='all';window.deviceSearchVal='';render()};
if($('#exportDevices'))$('#exportDevices').onclick=()=>csvDownload('rimbara-perangkat-simulasi.csv',[['ID','Zona','Suhu °C','Debit L/menit','Tekanan kPa','Komunikasi','Status','Data terakhir'],...devices.map(d=>[d.id,d.zone,d.comm==='offline'?'':d.temp,d.comm==='offline'?'':d.flow,d.comm==='offline'?'':d.pressure,d.comm,statusOf(d),d.lastUpdate])]);
if($('#activitySearch'))$('#activitySearch').oninput=e=>{window.activitySearchVal=e.target.value;let pos=e.target.selectionStart;render();$('#activitySearch')?.focus();$('#activitySearch')?.setSelectionRange(pos,pos)};
if($('#activityType'))$('#activityType').onchange=e=>{window.activityType=e.target.value;render()};
if($('#exportActivity'))$('#exportActivity').onclick=()=>csvDownload('rimbara-riwayat-aktivitas.csv',[['Waktu','Jenis','Referensi','Keterangan'],...activities.map(a=>[a.time,a.type,a.ref,a.desc])]);
if($('#applyReport'))$('#applyReport').onclick=()=>{let a=$('#reportStart').value,b=$('#reportEnd').value;if(!a||!b||a>b){toast('Periksa tanggal awal dan akhir.',true);return}reportStart=a;reportEnd=b;render()};
if($('#printReport'))$('#printReport').onclick=()=>window.print();
if($('#exportReport'))$('#exportReport').onclick=()=>csvDownload('rimbara-laporan-simulasi.csv',[['RIMBARA MONITOR — DATA SIMULASI'],['Periode',reportStart,reportEnd],['Perangkat terdaftar',devices.length],['Daring',summary().online],['Luring',summary().offline],['Suhu rata-rata °C',summary().avgTemp.toFixed(1)],['Debit total L/menit',summary().flow.toFixed(1)],['Tekanan rata-rata kPa',summary().avgPressure.toFixed(1)],[],['Peringatan','Waktu','Perangkat','Jenis','Nilai','Prioritas','Status'],...alerts.filter(a=>new Date(a.time)>=new Date(reportStart)&&new Date(a.time)<=new Date(reportEnd+'T23:59:59')).map(a=>[a.id,a.time,a.deviceId,a.type,a.value,a.priority,a.status])]);
if($('#settingsForm'))$('#settingsForm').onsubmit=e=>{e.preventDefault();let next={tempThreshold:+$('#tempThreshold').value,minFlow:+$('#minFlow').value,pressureMin:+$('#pressureMin').value,pressureMax:+$('#pressureMax').value,staleMinutes:+$('#staleMinutes').value,notifications:$('#notifications').checked};if(next.pressureMin>=next.pressureMax){toast('Tekanan minimum harus lebih kecil dari maksimum.',true);return}if(next.tempThreshold<20||next.tempThreshold>60||next.minFlow<0||next.staleMinutes<5){toast('Nilai berada di luar rentang yang diizinkan.',true);return}settings={...settings,...next};saveSettings();addActivity('Konfigurasi simulasi diubah','SETTINGS','Ambang pemantauan diperbarui');evaluateAlerts();toast('Pengaturan simulasi tersimpan.');render()};
if($('#resetSettings'))$('#resetSettings').onclick=()=>{settings={...defaults};saveSettings();addActivity('Konfigurasi simulasi diubah','SETTINGS','Pengaturan dikembalikan ke nilai awal');evaluateAlerts();toast('Pengaturan dikembalikan ke nilai awal.');render()};
if($('#profileForm'))$('#profileForm').onsubmit=e=>{e.preventDefault();settings.profileName=$('#profileName').value.trim();settings.profileRole=$('#profileRole').value;saveSettings();toast('Profil demo diperbarui.');render()};
if($('#resetData'))$('#resetData').onclick=()=>{if(confirm('Reset seluruh data demo ke kondisi awal?')){seedData();toast('Data demo direset.')}};
}
function startSim(){stopSim();simTimer=setInterval(()=>{if(!simRunning)return;devices.forEach(d=>{if(d.comm==='offline')return;d.temp=Math.max(27,Math.min(44,+(d.temp+(Math.random()-.48)*.55).toFixed(1)));d.flow=Math.max(0,Math.min(65,+(d.flow+(Math.random()-.5)*2.8).toFixed(1)));d.pressure=Math.max(0,Math.min(220,+(d.pressure+(Math.random()-.5)*3.5).toFixed(1)));d.lastUpdate=now().toISOString();d.history.push({t:d.lastUpdate,temp:d.temp,flow:d.flow,pressure:d.pressure});if(d.history.length>48)d.history.shift()});evaluateAlerts();if(currentPage==='home'||currentPage==='analytics'||currentPage==='map'||currentPage==='devices'||currentPage==='alerts'||currentPage==='reports')render();$('#clock').textContent=now().toLocaleString('id-ID',{weekday:'short',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit'});},12000)}
function stopSim(){if(simTimer){clearInterval(simTimer);simTimer=null}}
$('#nav').addEventListener('click',e=>{let b=e.target.closest('[data-page]');if(b)goto(b.dataset.page)});
$('#hamb').onclick=()=>{$('#sidebar').classList.toggle('open');$('#overlay').classList.toggle('show')};$('#overlay').onclick=()=>{$('#sidebar').classList.remove('open');$('#overlay').classList.remove('show')};
$('#bell').onclick=()=>goto('alerts');$('#profileBtn').onclick=()=>$('#profileMenu').classList.toggle('hidden');
$('#profileEdit').onclick=()=>goto('settings');$('#profileSettings').onclick=()=>goto('settings');$('#aboutBtn').onclick=()=>{ $('#profileMenu').classList.add('hidden');openModal('Tentang RIMBARA MONITOR',`<div class="notice">MODE DEMO — DATA SIMULASI, BUKAN DATA LAPANGAN.</div><p>RIMBARA (Rancang Inovasi Monitoring Bahaya dan Respons Aman) adalah konsep platform untuk mendemonstrasikan pemantauan kondisi gambut, distribusi air, indikasi potensi bahaya, dan koordinasi pemeriksaan.</p><p>Versi ini berjalan tanpa backend. Pengaturan disimpan pada localStorage browser, sementara data tugas dan aktivitas berada dalam memori sesi. Integrasi sensor nyata membutuhkan perangkat, API/MQTT, backend, keamanan, dan validasi lapangan.</p>`,'<button class="btn primary" id="aboutOk">Mengerti</button>');$('#aboutOk').onclick=closeModal};
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();$('#profileMenu').classList.add('hidden');$('#sidebar').classList.remove('open');$('#overlay').classList.remove('show')}});
$('#clock').textContent=now().toLocaleString('id-ID',{weekday:'short',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit'});
seedData();render();startSim();
</script>
</body>
</html>

<script>
"use strict";
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const now=()=>new Date();
const isoAgo=m=>new Date(Date.now()-m*60000).toISOString();
const fmtTime=v=>v?new Date(v).toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}):'—';
const fmtDate=v=>v?new Date(v).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}):'—';
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const defaults={tempThreshold:38,minFlow:18,pressureMin:95,pressureMax:190,staleMinutes:45,notifications:true,profileName:'Aulia Rahma Hanum',profileRole:'Operator Demo'};
let settings={...defaults};try{settings={...defaults,...JSON.parse(localStorage.getItem('rimbara-settings')||'{}')}}catch{}
const deviceSeed=[
{id:'N01',zone:'Blok Gambut A',temp:32.4,flow:48,pressure:152,comm:'online',sensor:'normal',age:2,x:22,y:30,depth:'20 cm'},
{id:'N02',zone:'Blok Gambut A',temp:36.8,flow:42,pressure:145,comm:'online',sensor:'normal',age:4,x:43,y:23,depth:'20 cm'},
{id:'N03',zone:'Blok Gambut B',temp:39.2,flow:12,pressure:88,comm:'online',sensor:'normal',age:3,x:62,y:48,depth:'30 cm'},
{id:'N04',zone:'Blok Gambut B',temp:34.1,flow:51,pressure:159,comm:'online',sensor:'normal',age:5,x:77,y:28,depth:'20 cm'},
{id:'N05',zone:'Blok Gambut C',temp:31.7,flow:0,pressure:0,comm:'offline',sensor:'unknown',age:130,x:34,y:70,depth:'30 cm'},
{id:'N06',zone:'Blok Gambut C',temp:37.4,flow:23,pressure:181,comm:'online',sensor:'normal',age:7,x:71,y:75,depth:'40 cm'}
];
let devices=deviceSeed.map(d=>({...d,lastUpdate:isoAgo(d.age),history:Array.from({length:24},(_,i)=>({t:new Date(Date.now()-(23-i)*15*60000).toISOString(),temp:+(d.temp+Math.sin(i*.42+d.x)*1.15+(i/23)*.4).toFixed(1),flow:Math.max(0,+(d.flow+Math.cos(i*.5+d.y)*4).toFixed(1)),pressure:Math.max(0,+(d.pressure+Math.sin(i*.4)*7).toFixed(1))}))}));
let alerts=[],tasks=[],activities=[],seqAlert=4,seqTask=4,selectedDevice='N01',currentPage='home',simRunning=true,simTimer=null,chartRange='6h',chartDevice='N01',chartMetric='temp',mapFilter='all',deviceFilter='all',alertFilter='all',taskFilter='all',reportStart=new Date(Date.now()-7*86400000).toISOString().slice(0,10),reportEnd=now().toISOString().slice(0,10);
function statusOf(d){if(d.comm==='offline'||Date.now()-new Date(d.lastUpdate).getTime()>settings.staleMinutes*60000)return'offline';if(d.temp>=settings.tempThreshold||d.flow<settings.minFlow||d.pressure<settings.pressureMin||d.pressure>settings.pressureMax)return d.temp>=settings.tempThreshold?'critical':'attention';if(d.temp>=settings.tempThreshold-2||d.pressure>settings.pressureMax-10)return'attention';return'normal'}
function statusLabel(s){return({normal:'Normal',attention:'Perlu perhatian',critical:'Prioritas tinggi',offline:'Luring'})[s]||s}
function badge(s){return `<span class="status ${s}">${statusLabel(s)}</span>`}
function addActivity(type,ref,desc){activities.unshift({id:'ACT-'+String(activities.length+1).padStart(3,'0'),time:now().toISOString(),type,ref,desc});}
function toast(msg,error=false){let el=document.createElement('div');el.className='toast'+(error?' error':'');el.textContent=msg;$('#toasts').appendChild(el);setTimeout(()=>el.remove(),3400)}
function saveSettings(){localStorage.setItem('rimbara-settings',JSON.stringify(settings))}
function evaluateAlerts(){let candidates=[];devices.forEach(d=>{if(d.comm==='offline'){candidates.push({device:d,type:'Data perangkat kedaluwarsa',value:`Data terakhir ${Math.round((Date.now()-new Date(d.lastUpdate).getTime())/60000)} menit lalu`,priority:'Tinggi',key:'offline'});return}
if(d.temp>=settings.tempThreshold)candidates.push({device:d,type:'Suhu tanah melampaui ambang',value:`${d.temp.toFixed(1)} °C`,priority:'Tinggi',key:'temp'});
else if(d.temp>=settings.tempThreshold-2)candidates.push({device:d,type:'Tren suhu perlu diverifikasi',value:`${d.temp.toFixed(1)} °C`,priority:'Sedang',key:'trend'});
if(d.flow<settings.minFlow)candidates.push({device:d,type:'Debit air di bawah batas',value:`${d.flow.toFixed(1)} L/menit`,priority:'Tinggi',key:'flow'});
if(d.pressure>0&&(d.pressure<settings.pressureMin||d.pressure>settings.pressureMax))candidates.push({device:d,type:'Tekanan air di luar rentang',value:`${d.pressure.toFixed(1)} kPa`,priority:'Sedang',key:'pressure'});});
candidates.forEach(c=>{if(!alerts.some(a=>a.deviceId===c.device.id&&a.key===c.key&&a.status!=='Selesai')){let a={id:'ALT-'+String(seqAlert++).padStart(3,'0'),time:now().toISOString(),deviceId:c.device.id,zone:c.device.zone,type:c.type,value:c.value,priority:c.priority,status:'Baru',key:c.key,detail:'Indikasi berdasarkan aturan ambang simulasi. Verifikasi kondisi di lapangan sebelum mengambil kesimpulan.'};alerts.unshift(a);addActivity('Peringatan baru',a.id,`${a.type} pada ${a.deviceId}`)}})}
function seedData(){alerts=[];tasks=[];activities=[];seqAlert=1;seqTask=1;devices=deviceSeed.map(d=>({...d,lastUpdate:isoAgo(d.age),history:Array.from({length:24},(_,i)=>({t:new Date(Date.now()-(23-i)*15*60000).toISOString(),temp:+(d.temp+Math.sin(i*.42+d.x)*1.15+(i/23)*.4).toFixed(1),flow:Math.max(0,+(d.flow+Math.cos(i*.5+d.y)*4).toFixed(1)),pressure:Math.max(0,+(d.pressure+Math.sin(i*.4)*7).toFixed(1))}))}));evaluateAlerts();addActivity('Sistem','DEMO','Data demo diinisialisasi');render()}
function summary(){let active=devices.filter(d=>d.comm==='online'),online=active.length,temps=active.map(d=>d.temp),flows=active.map(d=>d.flow),press=active.filter(d=>d.pressure>0).map(d=>d.pressure);return{avgTemp:temps.reduce((a,b)=>a+b,0)/(temps.length||1),flow:flows.reduce((a,b)=>a+b,0),avgPressure:press.reduce((a,b)=>a+b,0)/(press.length||1),online,offline:devices.length-online,alerts:alerts.filter(a=>a.status!=='Selesai').length,activeTasks:tasks.filter(t=>t.status!=='Selesai').length}}
function pathLine(data,w,h,min,max){let span=max-min||1;return data.map((v,i)=>`${i?'L':'M'} ${(i*w/Math.max(1,data.length-1)).toFixed(1)} ${(h-((v-min)/span)*h).toFixed(1)}`).join(' ')}
function chartSVG(series,opts={}){let w=640,h=200,pad={l:30,r:10,t:12,b:24},cw=w-pad.l-pad.r,ch=h-pad.t-pad.b;let all=series.flatMap(s=>s.values);if(!all.length)return'<div class="empty">Belum ada data grafik.</div>';let min=opts.min??Math.floor(Math.min(...all)-2),max=opts.max??Math.ceil(Math.max(...all)+2);if(max===min)max=min+1;let lines=series.map((s,idx)=>{let path=s.values.map((v,i)=>`${i?'L':'M'} ${(pad.l+i*cw/Math.max(1,s.values.length-1)).toFixed(1)} ${(pad.t+ch-(v-min)/(max-min)*ch).toFixed(1)}`).join(' ');let color=['#2d8a58','#d39a2e','#5687bb'][idx%3];let last=s.values[s.values.length-1];return `<path d="${path}" fill="none" stroke="${color}" stroke-width="2.7" stroke-linejoin="round" stroke-linecap="round"><title>${esc(s.name)}: ${last}</title></path><circle cx="${pad.l+cw}" cy="${pad.t+ch-(last-min)/(max-min)*ch}" r="4" fill="${color}"/>`}).join('');let grid=[0,.25,.5,.75,1].map(r=>{let y=pad.t+ch*r,val=max-(max-min)*r;return `<line x1="${pad.l}" y1="${y}" x2="${w-pad.r}" y2="${y}" stroke="#e9efeb" stroke-dasharray="3 4"/><text x="${pad.l-7}" y="${y+4}" font-size="10" fill="#8a968e" text-anchor="end">${val.toFixed(0)}</text>`}).join('');let labels=[0,Math.floor((series[0].values.length-1)/2),series[0].values.length-1].map((idx,i)=>`<text x="${pad.l+idx*cw/Math.max(1,series[0].values.length-1)}" y="${h-5}" text-anchor="${i===0?'start':i===2?'end':'middle'}" font-size="10" fill="#8a968e">${['-6j','-3j','Kini'][i]}</text>`).join('');return `<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="Grafik simulasi">${grid}${lines}${labels}</svg>`}
function chartFor(metric='temp',devId='N01',range='6h'){let d=devices.find(x=>x.id===devId)||devices[0],count=range==='1h'?5:range==='24h'?24:13;let history=d.history.slice(-count);let key=metric==='temp'?'temp':metric==='flow'?'flow':'pressure';let values=history.map(h=>h[key]);return{values,series:[{name:d.id,values}],last:values.at(-1),min:Math.min(...values),max:Math.max(...values)}}
function pageHeader(title,desc,action=''){return `<div class="welcome"><div><h1>${title}</h1><p>${desc}</p></div>${action}</div>`}
function statCard(label,value,unit,icon,foot,page,filter){return `<div class="stat" role="button" tabindex="0" data-goto="${page}" ${filter?`data-filter="${filter}"`:''}><div class="stat-top"><span>${label}</span><span class="stat-icon">${icon}</span></div><div class="stat-value">${value}<span style="font-size:12px;font-weight:650;color:#718078"> ${unit||''}</span></div><div class="stat-foot">${foot}</div></div>`}
function recentAlertCards(limit=4){let list=alerts.filter(a=>a.status!=='Selesai').slice(0,limit);return list.length?list.map(a=>`<div class="alert-card ${a.priority==='Tinggi'?'high':''}" data-alert="${a.id}" role="button" tabindex="0"><div style="display:flex;justify-content:space-between;gap:8px"><h4>${esc(a.type)}</h4><span class="pill">${esc(a.priority)}</span></div><p>${a.deviceId} · ${esc(a.zone)} · ${esc(a.value)}</p><div class="alert-meta"><span>${fmtTime(a.time)}</span><span>${esc(a.status)} →</span></div></div>`).join(''):'<div class="empty">Tidak ada peringatan aktif. Kondisi simulasi dalam batas yang dikonfigurasi.</div>'}
function deviceTable(rows){return `<div class="table-wrap"><table><thead><tr><th>Perangkat</th><th>Zona</th><th>Suhu</th><th>Debit</th><th>Tekanan</th><th>Komunikasi</th><th>Status</th><th>Data terakhir</th><th>Aksi</th></tr></thead><tbody>${rows.map(d=>`<tr><td><strong>${d.id}</strong></td><td>${esc(d.zone)}</td><td>${d.comm==='offline'?'—':d.temp.toFixed(1)+' °C'}</td><td>${d.comm==='offline'?'—':d.flow.toFixed(1)+' L/mnt'}</td><td>${d.comm==='offline'?'—':d.pressure.toFixed(1)+' kPa'}</td><td>${badge(d.comm==='offline'?'offline':'normal')}</td><td>${badge(statusOf(d))}</td><td>${fmtTime(d.lastUpdate)}</td><td><button class="btn small" data-device="${d.id}">Detail</button></td></tr>`).join('')}</tbody></table></div>`}
function renderHome(){let s=summary(),active=devices.filter(d=>d.comm==='online'),drows=devices.filter(d=>statusOf(d)!=='normal');return `${pageHeader('Dashboard Pemantauan Gambut','Ringkasan kondisi pemantauan area gambut dan distribusi air.','<button class="btn" id="toggleSim">'+(simRunning?'Ⅱ Jeda simulasi':'▶ Lanjutkan simulasi')+'</button>')}<div class="demo-banner"><span>⚠</span><div><strong>MODE DEMO — DATA SIMULASI, BUKAN DATA LAPANGAN.</strong><br><span>Nilai, lokasi, peringatan, dan pembaruan di bawah ini bersifat ilustratif; bukan hasil pembacaan sensor fisik.</span></div></div><div class="grid stats">${statCard('Suhu tanah rata-rata',s.avgTemp.toFixed(1),'°C','♨','Rata-rata perangkat daring','analytics')}${statCard('Debit air total',s.flow.toFixed(0),'L/menit','≈','Total debit simulasi','analytics')}${statCard('Tekanan air rata-rata',s.avgPressure.toFixed(0),'kPa','◉','Dari perangkat dengan data','analytics')}${statCard('Perangkat daring',s.online+'/'+devices.length,'unit','⌁',s.offline+' perangkat luring','devices','offline')}${statCard('Perangkat terdaftar',devices.length,'unit','▦','Titik simulasi N01–N06','map')}${statCard('Peringatan aktif',s.alerts,'item','⚑','Perlu verifikasi petugas','alerts')}</div><div class="grid cols2"><section class="panel"><div class="panel-head"><div><h2>Tren suhu tanah</h2><div class="sub">Perubahan ilustratif pada perangkat N01–N06</div></div><button class="linkbtn" data-goto="analytics">Analisis lengkap →</button></div><div class="chart">${chartSVG(devices.filter(d=>d.comm==='online').slice(0,3).map(d=>({name:d.id,values:d.history.slice(-13).map(h=>h.temp)})),{min:25,max:43})}</div><div class="legend"><span><i style="background:#2d8a58"></i>N01</span><span><i style="background:#d39a2e"></i>N02</span><span><i style="background:#5687bb"></i>N03</span></div></section><section class="panel"><div class="panel-head"><div><h2>Distribusi air</h2><div class="sub">Debit per perangkat (L/menit)</div></div><button class="linkbtn" data-goto="analytics">Lihat data →</button></div><div class="chart">${chartSVG(devices.map(d=>({name:d.id,values:d.history.slice(-13).map(h=>h.flow)})),{min:0,max:65})}</div><div class="legend"><span><i style="background:#2d8a58"></i>Debit air</span><span class="sub">Nilai nol dapat menunjukkan gangguan atau data simulasi.</span></div></section></div><div class="grid cols2"><section class="panel"><div class="panel-head"><div><h2>Perangkat yang membutuhkan perhatian</h2><div class="sub">${drows.length} perangkat dengan status selain normal</div></div><button class="linkbtn" data-goto="devices">Semua perangkat →</button></div>${drows.length?deviceTable(drows):'<div class="empty">Semua perangkat simulasi berstatus normal.</div>'}</section><section class="panel"><div class="panel-head"><div><h2>Peringatan terbaru</h2><div class="sub">Indikasi potensi bahaya, perlu verifikasi</div></div><button class="linkbtn" data-goto="alerts">Lihat semua →</button></div>${recentAlertCards(4)}</section></div><section class="panel"><div class="panel-head"><div><h2>Ringkasan tugas lapangan</h2><div class="sub">Koordinasi tugas hanya tersimpan di prototipe lokal</div></div><button class="btn small" data-goto="tasks">Kelola tugas →</button></div>${tasks.length?tasks.slice(0,3).map(taskCard).join(''):'<div class="empty">Belum ada tugas. Buat tugas pemeriksaan dari menu Tugas Lapangan atau dari detail peringatan.</div>'}</section>`}
function taskCard(t){return `<div class="task-card"><div class="task-card-head"><h4>${esc(t.id)} · ${esc(t.type)}</h4>${badge(t.status==='Selesai'?'normal':t.status==='Sedang Diperiksa'?'attention':'offline')}</div><p>${esc(t.deviceId||t.zone)} · Petugas: ${esc(t.assignee)} · Prioritas ${esc(t.priority)}</p><div style="display:flex;justify-content:space-between;gap:10px;align-items:center"><span class="sub">${fmtTime(t.createdAt)}</span><button class="btn small" data-task="${t.id}">Buka tugas</button></div></div>`}
function renderMap(){let visible=devices.filter(d=>mapFilter==='all'||statusOf(d)===mapFilter).filter(d=>!$('#mapSearch')||d.id.toLowerCase().includes($('#mapSearch').value.toLowerCase()));let d=devices.find(x=>x.id===selectedDevice)||devices[0];return `${pageHeader('Peta Pemantauan','Pilih titik perangkat untuk melihat ringkasan pembacaan simulasi.')}<div class="demo-banner"><span>⌖</span><div><strong>LOKASI ILUSTRATIF</strong><br><span>Posisi pada peta ini hanya visualisasi, bukan koordinat pemasangan sebenarnya.</span></div></div><div class="filters"><input id="mapSearch" placeholder="Cari ID perangkat, mis. N03" value="${esc(window.mapSearchVal||'')}"><select id="mapFilter"><option value="all">Semua status</option><option value="normal">Normal</option><option value="attention">Perlu perhatian</option><option value="critical">Prioritas tinggi</option><option value="offline">Luring</option></select><button class="btn" id="mapReset">Reset filter</button></div><div class="map-layout"><section class="panel"><div class="panel-head"><div><h2>Area gambut simulasi</h2><div class="sub">6 titik nozzle tanam RIMBARA • ilustrasi topologi area</div></div><span class="pill">Peta demo</span></div><div class="map-canvas"><svg viewBox="0 0 700 440" preserveAspectRatio="xMidYMid slice" aria-label="Ilustrasi area gambut"><defs><pattern id="gridPat" width="30" height="30" patternUnits="userSpaceOnUse"><path d="M 30 0 L 0 0 0 30" fill="none" stroke="#c9dac8" stroke-width=".7"/></pattern></defs><rect width="700" height="440" fill="#e9f1e5"/><rect width="700" height="440" fill="url(#gridPat)"/><path d="M-20 110 C110 70 160 170 270 125 S450 55 720 130 L720 190 C500 120 400 235 270 190 S90 140 -20 175Z" fill="#d2e4cf"/><path d="M-20 315 C100 250 180 380 320 320 S540 270 720 335 L720 400 C520 355 420 420 300 370 S100 330 -20 380Z" fill="#d5e5cf"/><path d="M45 15 Q120 140 190 200 T350 430 M600 0 Q500 130 520 220 T650 440" stroke="#a6c9b0" stroke-width="18" fill="none" opacity=".55"/><path d="M45 15 Q120 140 190 200 T350 430 M600 0 Q500 130 520 220 T650 440" stroke="#fff" stroke-width="2" stroke-dasharray="7 7" fill="none"/><g fill="#c5d9bc" stroke="#b2cba8"><path d="M70 235 l30 -24 32 13 12 34 -29 24 -34 -13z"/><path d="M405 35 l45 -10 27 25 -12 36 -45 6 -23 -25z"/><path d="M455 300 l39 -20 29 19 -4 35 -37 16 -31 -21z"/><path d="M225 40 l22 -15 26 15 -5 27 -29 9 -18 -16z"/></g><g fill="#6f9a71" opacity=".65">${Array.from({length:35},(_,i)=>`<circle cx="${25+(i*73)%650}" cy="${20+(i*47)%400}" r="${3+(i%3)}"/>`).join('')}</g><text x="350" y="218" font-size="16" fill="#729377" text-anchor="middle" font-weight="700" opacity=".8">AREA GAMBUT SIMULASI</text><text x="350" y="239" font-size="10" fill="#729377" text-anchor="middle">Lokasi tidak merepresentasikan koordinat aktual</text></svg><div class="map-fallback-label">◎ Visualisasi lokal • tanpa peta eksternal</div>${visible.map(p=>`<button class="map-pin ${statusOf(p)} ${selectedDevice===p.id?'selected':''}" style="left:${p.x}%;top:${p.y}%" data-pick="${p.id}" title="${p.id}: ${statusLabel(statusOf(p))}">${p.id}</button>`).join('')}</div><div class="legend"><span><i style="background:#2d8a58"></i>Normal</span><span><i style="background:#d69520"></i>Perlu perhatian</span><span><i style="background:#c34545"></i>Prioritas tinggi</span><span><i style="background:#7f8a83"></i>Luring</span></div></section><section class="panel"><div class="panel-head"><div><h2>Detail titik perangkat</h2><div class="sub">Pilih titik pada peta</div></div></div><div class="device-detail"><div style="display:flex;justify-content:space-between;gap:8px;align-items:center"><div><div class="sub">${esc(d.zone)}</div><h2 style="font-size:24px;margin:2px 0">${d.id}</h2></div>${badge(statusOf(d))}</div><div class="detail-grid"><div class="detail-item"><span>Suhu tanah</span><strong>${d.comm==='offline'?'—':d.temp.toFixed(1)+' °C'}</strong></div><div class="detail-item"><span>Debit air</span><strong>${d.comm==='offline'?'—':d.flow.toFixed(1)+' L/menit'}</strong></div><div class="detail-item"><span>Tekanan air</span><strong>${d.comm==='offline'?'—':d.pressure.toFixed(1)+' kPa'}</strong></div><div class="detail-item"><span>Komunikasi</span><strong>${d.comm==='offline'?'Luring':'Daring (simulasi)'}</strong></div><div class="detail-item"><span>Kedalaman sensor</span><strong>${d.depth}</strong></div><div class="detail-item"><span>Data terakhir</span><strong>${fmtTime(d.lastUpdate)}</strong></div></div><button class="btn primary" style="width:100%" data-device="${d.id}">Buka detail perangkat</button><button class="btn" style="width:100%;margin-top:8px" data-create-task="${d.id}">＋ Buat tugas pemeriksaan</button></div></section></div>`}

function renderAnalytics(){let d=devices.find(x=>x.id===chartDevice)||devices[0],metric=chartMetric,chart=chartFor(metric,chartDevice,chartRange),unit=metric==='temp'?'°C':metric==='flow'?'L/menit':'kPa',label=metric==='temp'?'Suhu tanah':metric==='flow'?'Debit air':'Tekanan air';let selected=d.comm==='offline'?'Data perangkat luring; grafik berikut menunjukkan histori simulasi terakhir, bukan pembacaan terkini.':`Data simulasi ${d.id} · kedalaman ${d.depth}`;return `${pageHeader('Data dan Grafik','Analisis perubahan suhu tanah, debit air, dan tekanan air.')}<div class="demo-banner"><span>▥</span><div><strong>ANALISIS SIMULASI</strong><br><span>Ambang dan rentang operasi dapat diubah di Pengaturan untuk menguji respons sistem.</span></div></div><section class="panel"><div class="panel-head"><div><h2>Parameter analisis</h2><div class="sub">Filter memperbarui grafik dan statistik di bawah.</div></div></div><div class="filters"><select id="chartDevice">${devices.map(x=>`<option value="${x.id}" ${x.id===chartDevice?'selected':''}>${x.id} · ${x.zone}</option>`).join('')}</select><select id="chartMetric"><option value="temp" ${metric==='temp'?'selected':''}>Suhu tanah</option><option value="flow" ${metric==='flow'?'selected':''}>Debit air</option><option value="pressure" ${metric==='pressure'?'selected':''}>Tekanan air</option></select><select id="chartRange"><option value="1h" ${chartRange==='1h'?'selected':''}>1 jam</option><option value="6h" ${chartRange==='6h'?'selected':''}>6 jam</option><option value="24h" ${chartRange==='24h'?'selected':''}>24 jam</option></select></div><div class="notice">${selected}</div><div class="grid stats" style="grid-template-columns:repeat(3,minmax(0,1fr))"><div class="stat" style="cursor:default"><div class="stat-top">Nilai terakhir <span class="stat-icon">◉</span></div><div class="stat-value">${chart.last.toFixed(1)}<span style="font-size:12px;color:var(--muted)"> ${unit}</span></div><div class="stat-foot">Pada histori simulasi</div></div><div class="stat" style="cursor:default"><div class="stat-top">Nilai tertinggi <span class="stat-icon">↑</span></div><div class="stat-value">${chart.max.toFixed(1)}<span style="font-size:12px;color:var(--muted)"> ${unit}</span></div><div class="stat-foot">Dalam rentang terpilih</div></div><div class="stat" style="cursor:default"><div class="stat-top">Status aturan <span class="stat-icon">⚑</span></div><div class="stat-value" style="font-size:19px">${metric==='temp'?(chart.last>=settings.tempThreshold?'Melewati ambang':chart.last>=settings.tempThreshold-2?'Perlu verifikasi':'Dalam batas'):metric==='flow'?(chart.last<settings.minFlow?'Debit rendah':'Dalam batas'):(chart.last<settings.pressureMin||chart.last>settings.pressureMax?'Di luar rentang':'Dalam batas')}</div><div class="stat-foot">Aturan simulasi lokal</div></div></div><div class="panel-head"><div><h2>${label} · ${d.id}</h2><div class="sub">Satuan ${unit} · data berkala simulasi</div></div><span class="pill">${chartRange}</span></div><div class="chart" style="height:300px">${chartSVG([{name:label,values:chart.values}],{min:Math.max(0,Math.floor(chart.min-3)),max:Math.ceil(chart.max+3)})}</div><div class="legend"><span><i style="background:#2d8a58"></i>${label}</span><span class="sub">Grafik diperbarui saat filter diubah atau simulasi berjalan.</span></div></section><div class="grid cols2"><section class="panel"><div class="panel-head"><div><h2>Distribusi air per perangkat</h2><div class="sub">Debit air (L/menit)</div></div></div><div class="chart">${chartSVG(devices.map(x=>({name:x.id,values:x.history.slice(-12).map(h=>h.flow)})),{min:0,max:65})}</div></section><section class="panel"><div class="panel-head"><div><h2>Tekanan air per perangkat</h2><div class="sub">Tekanan (kPa)</div></div></div><div class="chart">${chartSVG(devices.map(x=>({name:x.id,values:x.history.slice(-12).map(h=>h.pressure)})),{min:0,max:210})}</div><div class="notice">Debit terlalu rendah atau tekanan di luar rentang dapat mengindikasikan gangguan distribusi air. Perlu pemeriksaan lebih lanjut. Status katup fisik tidak tersedia pada prototipe ini.</div></section></div><section class="panel"><div class="panel-head"><div><h2>Data perangkat yang digunakan</h2><div class="sub">Nilai konsisten dengan kartu ringkasan dan tabel perangkat.</div></div></div>${deviceTable(devices)}</section>`}
function renderAlerts(){let q=window.alertSearchVal||'',list=alerts.filter(a=>(alertFilter==='all'||a.status===alertFilter)&&(!q||(a.id+a.deviceId+a.zone+a.type).toLowerCase().includes(q.toLowerCase())));return `${pageHeader('Peringatan Dini','Pantau indikasi yang memerlukan verifikasi petugas.')}<div class="demo-banner"><span>⚑</span><div><strong>PERINGATAN BUKAN KONFIRMASI KEBAKARAN</strong><br><span>Kenaikan suhu, debit rendah, atau data kedaluwarsa adalah indikasi berbasis aturan simulasi dan harus diverifikasi.</span></div></div><div class="filters"><input id="alertSearch" placeholder="Cari ID, perangkat, zona, jenis…" value="${esc(q)}"><select id="alertFilter"><option value="all">Semua status</option>${['Baru','Sedang Diperiksa','Selesai'].map(s=>`<option ${alertFilter===s?'selected':''}>${s}</option>`).join('')}</select><select id="alertPriority"><option value="all">Semua prioritas</option><option>Tinggi</option><option>Sedang</option></select><button class="btn" id="clearAlertFilters">Reset filter</button></div><section class="panel"><div class="panel-head"><div><h2>Daftar peringatan</h2><div class="sub">${list.length} item · peringatan selesai tetap disimpan dalam riwayat</div></div></div>${list.length?`<div class="table-wrap"><table><thead><tr><th>ID</th><th>Waktu</th><th>Perangkat / Zona</th><th>Jenis peringatan</th><th>Nilai</th><th>Prioritas</th><th>Status tindak lanjut</th><th>Aksi</th></tr></thead><tbody>${list.filter(a=>$('#alertPriority')?.value==='all'||!$('#alertPriority')||a.priority===$('#alertPriority').value).map(a=>`<tr><td><strong>${a.id}</strong></td><td>${fmtTime(a.time)}</td><td>${a.deviceId}<br><span class="sub">${esc(a.zone)}</span></td><td>${esc(a.type)}</td><td>${esc(a.value)}</td><td><span class="status ${a.priority==='Tinggi'?'critical':'attention'}">${a.priority}</span></td><td>${badge(a.status==='Selesai'?'normal':a.status==='Sedang Diperiksa'?'attention':'offline')}</td><td><button class="btn small" data-alert="${a.id}">Detail</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Tidak ada peringatan sesuai filter.</div>'}</section>`}

    <button data-page="map"><span class="ico">⌖</span>Peta Pemantauan</button>
    <button data-page="analytics"><span class="ico">▥</span>Data dan Grafik</button>
    <button data-page="alerts"><span class="ico">⚑</span>Peringatan Dini <span id="navAlertCount" class="pill" style="margin-left:auto">0</span></button>

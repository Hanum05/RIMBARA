function createTask(deviceId='',alertId=''){let d=devices.find(x=>x.id===deviceId)||devices[0];openModal('Buat tugas pemeriksaan',`<form id="createTaskForm"><div class="form-grid"><div class="field"><label>Perangkat</label><select name="deviceId">${devices.map(x=>`<option value="${x.id}" ${x.id===d.id?'selected':''}>${x.id} · ${x.zone}</option>`).join('')}</select></div><div class="field"><label>Jenis pemeriksaan</label><select name="type"><option>Pemeriksaan distribusi air</option><option>Verifikasi suhu tanah</option><option>Pemeriksaan sensor dan komunikasi</option><option>Pemeriksaan umum area</option></select></div><div class="field"><label>Prioritas</label><select name="priority"><option>Sedang</option><option>Tinggi</option><option>Rendah</option></select></div><div class="field"><label>Nama petugas</label><input name="assignee" required placeholder="Nama petugas demo"></div><div class="field full"><label>Catatan instruksi</label><textarea name="notes" placeholder="Instruksi pemeriksaan…">${alertId?'Verifikasi peringatan '+alertId+'. ':''}</textarea></div></div><button class="btn primary" type="submit">Simpan tugas demo</button></form>`);$('#createTaskForm').onsubmit=e=>{e.preventDefault();let f=new FormData(e.target),id='TSK-'+String(seqTask++).padStart(3,'0'),dev=devices.find(x=>x.id===f.get('deviceId'));tasks.unshift({id,deviceId:dev.id,zone:dev.zone,type:f.get('type'),priority:f.get('priority'),assignee:f.get('assignee').trim(),notes:f.get('notes').trim(),status:'Ditugaskan',createdAt:now().toISOString(),alertId,results:null});addActivity('Petugas ditugaskan',id,`${dev.id} ditugaskan kepada ${f.get('assignee').trim()}`);closeModal();toast('Tugas '+id+' berhasil dibuat di simulasi.');goto('tasks')}}
